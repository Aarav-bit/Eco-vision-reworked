# ----------------------
# ROOT / GENERAL
# ----------------------
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp

# ----------------------
# IDE / EDITOR
# ----------------------
.vscode/
.idea/
*.iml

# ----------------------
# FLUTTER APP (mobile_app)
# ----------------------
mobile_app/.dart_tool/
mobile_app/.packages
mobile_app/.pub-cache/
mobile_app/.pub/
mobile_app/build/
mobile_app/.flutter-plugins
mobile_app/.flutter-plugins-dependencies

# Platform-specific (generated)
mobile_app/linux/flutter/
mobile_app/linux/runner/

# ----------------------
# BACKEND (Python / FastAPI)
# ----------------------
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.py[cod]
backend/*.py[cod]
backend/*.sqlite3

# Virtual environments
backend/venv/
backend/env/
backend/.venv/

# Environment variables
backend/.env
backend/.env.*

# Uploaded images (ephemeral, not committed)
backend/uploads/*.jpg
backend/uploads/*.jpeg
backend/uploads/*.png
backend/uploads/*.webp

# ----------------------
# TEST / CACHE
# ----------------------
.coverage
htmlcov/
.pytest_cache/

# ----------------------
# FRONTEND (Next.js)
# ----------------------
frontend/.env.local
frontend/node_modules/
frontend/.next/

# ----------------------
# DEMO / TEST ARTIFACTS
# ----------------------
demo_images/
backend/test_demo_images.py